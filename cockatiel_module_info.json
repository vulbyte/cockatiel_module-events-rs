{
  "name": "events",
  "description": "chat events \u2014 !pred start/stop/bet (zero-sum parimutuel predictions) and !poll (free-vote polls), one shared display window",
  "version": "0.1.0",
  "capabilities": "preprocess",
  "root_file": "./src/bin/event_brain.rs",
  "launch_command": "cargo",
  "command_flags": [
    "run",
    "--release"
  ],
  "binary": {
    "linux": {
      "aarch64": "target/release/event_brain",
      "arm": "target/release/event_brain",
      "x86_64": "target/release/event_brain"
    },
    "macos": {
      "aarch64": "target/release/event_brain",
      "arm": "target/release/event_brain",
      "x86_64": "target/release/event_brain"
    },
    "windows": {
      "aarch64": "target/release/event_brain.exe",
      "arm": "target/release/event_brain.exe",
      "x86_64": "target/release/event_brain.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "credentials": [],
  "autostart": false,
  "terminal": false,
  "price": 0,
  "min_rank": 0,
  "authority": 0
}
